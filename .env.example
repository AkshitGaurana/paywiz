# Copy this file to .env.local and fill in your values.
# Never commit .env.local to GitHub.

# Google AI Studio -> Get API key (one key per team)
GEMINI_API_KEY=

# Gemini model name. gemini-3.5-flash is tested with PayWise function calling.
# Avoid gemini-3.8-flash for now: it returned 503 "high demand" and hung requests.
GEMINI_MODEL=gemini-3.5-flash

# Supabase -> Project Settings -> Project URL
SUPABASE_URL=

# Supabase -> Project Settings -> API Keys -> secret key (service_role)
# Server only. Never use this in frontend code.
SUPABASE_SECRET_KEY=

# Your team's passcode. It protects your app and your Gemini quota.
APP_PASSCODE=
